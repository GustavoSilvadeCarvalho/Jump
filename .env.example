# Copie pra .env e ponha a connection string do seu banco Neon
# (Neon → projeto → Connection string → Pooled connection)
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Código de sincronização. Gere um aleatório e longo, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SYNC_TOKEN=troque-por-um-valor-aleatorio-longo
